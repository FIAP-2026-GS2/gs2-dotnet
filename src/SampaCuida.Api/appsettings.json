{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sampa-cuida-api",
    "Audience": "sampa-cuida",
    "ExpirationMinutes": 60
  },
  "Detection": {
    "MinConfidence": 0.5
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "IaService": { "TokenLimit": 100, "TokensPerPeriod": 50, "ReplenishmentSeconds": 60 },
    "Public": { "PermitLimit": 60, "WindowSeconds": 60, "Segments": 6 },
    "Default": { "PermitLimit": 120, "WindowSeconds": 60, "Segments": 6 }
  },
  "Schedule": {
    "ToleranceMinutes": 30,
    "FloodingIntervalHours": 3,
    "TimeZone": "America/Sao_Paulo"
  }
}
