{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SampaCuida;User Id=sa;Password=<senha-do-.env>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "sampa-cuida-api",
    "Audience": "sampa-cuida",
    "Key": "<chave-com-no-minimo-32-caracteres; gere com: openssl rand -base64 48>",
    "ExpirationMinutes": 60,
    "AdditionalValidIssuers": []
  },
  "Detection": {
    "MinConfidence": 0.5
  },
  "Schedule": {
    "ToleranceMinutes": 30,
    "FloodingIntervalHours": 3,
    "TimeZone": "America/Sao_Paulo"
  },
  "Auth": {
    "Users": [
      { "Username": "<usuario-gestor>", "PasswordHash": "<hash gerado com: dotnet run --project src/SampaCuida.Api -- hash-password 'senha'>", "Role": "GESTOR" },
      { "Username": "<usuario-servico-ia>", "PasswordHash": "<hash da senha do serviço de IA>", "Role": "IA_SERVICE" }
    ]
  }
}
