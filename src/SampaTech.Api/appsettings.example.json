{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SampaTech;User Id=sa;Password=<senha-do-.env>;TrustServerCertificate=True",
    "BlobStorage": "<opcional: connection string da Storage Account; vazio = check não registrado>",
    "RabbitMq": "<opcional: amqp://usuario:senha@host:5672/; vazio = check não registrado>"
  },
  "AiService": {
    "BaseUrl": "<opcional: URL do serviço de IA, ex. https://ia.exemplo.com; o check chama BaseUrl/health>"
  },
  "BlobStorage": {
    "ContainerName": "frames"
  },
  "HealthChecks": {
    "TimeoutSeconds": 3
  },
  "Jwt": {
    "Issuer": "sampatech-api",
    "Audience": "sampatech",
    "Key": "<chave-com-no-minimo-32-caracteres; gere com: openssl rand -base64 48>",
    "ExpirationMinutes": 60,
    "AdditionalValidIssuers": []
  },
  "Detection": {
    "MinConfidence": 0.5
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "IaService": { "TokenLimit": 100, "TokensPerPeriod": 50, "ReplenishmentSeconds": 60 },
    "Public": { "PermitLimit": 60, "WindowSeconds": 60, "Segments": 6 },
    "Default": { "PermitLimit": 120, "WindowSeconds": 60, "Segments": 6 }
  },
  "Schedule": {
    "ToleranceMinutes": 30,
    "FloodingIntervalHours": 3,
    "TimeZone": "America/Sao_Paulo"
  },
  "Auth": {
    "Users": [
      { "Username": "<usuario-admin>", "PasswordHash": "<hash gerado com: dotnet run --project src/SampaTech.Api -- hash-password 'senha'>", "Role": "ADMIN" },
      { "Username": "<usuario-gestor>", "PasswordHash": "<hash da senha do gestor>", "Role": "MANAGER" },
      { "Username": "<usuario-consulta>", "PasswordHash": "<hash da senha de consulta>", "Role": "VIEWER" },
      { "Username": "<usuario-servico-ia>", "PasswordHash": "<hash da senha do serviço de IA>", "Role": "IA_SERVICE" }
    ]
  }
}
